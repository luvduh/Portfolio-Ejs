<%- include('partials/header') %>

<h1>Contact</h1>

<p class="intro">
  Want to talk about a project, or just say hi? Send me a message below
  or find me online.
</p>

<ul class="contact-list">
  <li><i class="fa-solid fa-envelope"></i> <a href="mailto:ashwin.aju@ontariotechu.net">ashwin.aju@ontariotechu.net</a></li>
  <li><i class="fa-brands fa-github"></i> <a href="https://github.com/luvduh" target="_blank">github.com/luvduh</a></li>
</ul>

<h2>Send a message</h2>

<% if (sentName) { %>
  <p class="sent">Thanks, <%= sentName %>! Your message was sent. I'll get back to you soon.</p>
<% } else { %>
  <form action="/contact" method="POST" class="contact-form">
    <div class="mb-3">
      <label for="name" class="form-label">Name</label>
      <input type="text" id="name" name="name" class="form-control" required>
    </div>
    <div class="mb-3">
      <label for="email" class="form-label">Email</label>
      <input type="email" id="email" name="email" class="form-control" required>
    </div>
    <div class="mb-3">
      <label for="message" class="form-label">Message</label>
      <textarea id="message" name="message" rows="5" class="form-control" required></textarea>
    </div>
    <button type="submit" class="btn-send">Send</button>
  </form>
<% } %>

<%- include('partials/footer') %>
