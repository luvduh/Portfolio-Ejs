<%- include('partials/header') %>

<h1>Projects</h1>

<p class="intro">Things I've built. The code for each one is on GitHub.</p>

<% projects.forEach(function(project) { %>
  <section class="project">
    <h2><%= project.name %></h2>
    <p><%= project.description %></p>
    <p class="muted small mb-2"><%= project.tech.join(' · ') %></p>
    <p class="project-links mb-0">
      <a href="<%= project.github %>" target="_blank"><i class="fa-brands fa-github"></i> Code</a>
      <% if (project.demo) { %>
        <a href="<%= project.demo %>" class="ms-3"><i class="fa-solid fa-arrow-up-right-from-square"></i> Live</a>
      <% } %>
    </p>
  </section>
<% }); %>

<%- include('partials/footer') %>
